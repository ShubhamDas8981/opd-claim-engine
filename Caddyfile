# One address for everything:
#   /api/*   -> the backend (the /api prefix is removed before it reaches the app)
#   anything else -> the React website
{$SITE_ADDRESS::80} {
	encode gzip

	# the metrics page is for Prometheus only, never for the public
	@internal path /api/metrics /api/metrics/*
	respond @internal 404

	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy frontend:80
	}
}
